CC      = gcc
CFLAGS  = -Wall -Wextra -g 

#---------- EXECUTABLE ---------------
PTHREAD_BARRIER_TARGET = barrier_pthread
MUTEX_COND_BARRIER_TARGET = barrier_mutex_cond
SENSE_REVERSAL_CENTRALIZED_BARRIER_TARGET = barrier_sense_reversal_centralized

#---------- SOURCE FILES ---------------
PTHREAD_BARRIER_SRC = ./src/barrier_pthead.c
MUTEX_COND_BARRIER_SRC = ./src/barrier_mutex_cond.c
SENSE_REVERSAL_CENTRALIZED_BARRIER_SRC  = ./src/barrier_sense_reversal_centralized.c


all: $(PTHREAD_BARRIER_TARGET) $(MUTEX_COND_BARRIER_TARGET) $(SENSE_REVERSAL_CENTRALIZED_BARRIER_TARGET)

$(PTHREAD_BARRIER_TARGET): $(PTHREAD_BARRIER_SRC)
	$(CC) $(CFLAGS) $(PTHREAD_BARRIER_SRC) -o $(PTHREAD_BARRIER_TARGET) -lpthread

$(MUTEX_COND_BARRIER_TARGET): $(MUTEX_COND_BARRIER_SRC)
	$(CC) $(CFLAGS) $(MUTEX_COND_BARRIER_SRC) -o $(MUTEX_COND_BARRIER_TARGET) -lpthread

$(SENSE_REVERSAL_CENTRALIZED_BARRIER_TARGET): $(SENSE_REVERSAL_CENTRALIZED_BARRIER_SRC)
	$(CC) $(CFLAGS) $(SENSE_REVERSAL_CENTRALIZED_BARRIER_SRC) -o $(SENSE_REVERSAL_CENTRALIZED_BARRIER_TARGET) -lpthread

#---------- COMMANDS ---------------
run_barrier_pthead: $(PTHREAD_BARRIER_TARGET)
	./$(PTHREAD_BARRIER_TARGET) 3

run_barrier_mutex_cond: $(MUTEX_COND_BARRIER_TARGET)
	./$(MUTEX_COND_BARRIER_TARGET) 3

run_barrier_sense_reversal_centralized: $(SENSE_REVERSAL_CENTRALIZED_BARRIER_TARGET)
	./$(SENSE_REVERSAL_CENTRALIZED_BARRIER_TARGET) 16

valgrind_barrier_pthead: $(PTHREAD_BARRIER_TARGET)
	valgrind ./$(PTHREAD_BARRIER_TARGET) 2

valgrind_barrier_mutex_cond: $(MUTEX_COND_BARRIER_TARGET)
	valgrind ./$(MUTEX_COND_BARRIER_TARGET) 2
	
valgrind_barrier_sense_reversal_centralized: $(SENSE_REVERSAL_CENTRALIZED_BARRIER_TARGET)
	valgrind ./$(SENSE_REVERSAL_CENTRALIZED_BARRIER_TARGET) 2

#---------- CLEAN ---------------
clean:
	rm -f $(PTHREAD_BARRIER_TARGET) $(MUTEX_COND_BARRIER_TARGET) $(SENSE_REVERSAL_CENTRALIZED_BARRIER_TARGET)